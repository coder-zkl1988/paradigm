# Copy to apps/server/.env (or export these) before `npm run dev`.
# Nothing here is required: without a key or command, that service runs as a
# clearly marked stand-in and the board still works.

PORT=8787
HOST=127.0.0.1
# Where the database, board folders and made files are kept.
PARADIGM_DATA=./data
# The address people open (used in email and invite links).
PUBLIC_URL=http://localhost:5173
# Browser origins allowed to call the API (comma separated).
WEB_ORIGIN=http://localhost:5173
# 1 = print email links in the server log and return them to the page (development).
PARADIGM_DEV_MAIL=1
# Send email over SMTP (any provider with an SMTP address). Overrides the line above.
#   SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Paradigm <no-reply@example.com>

# Single sign-on with any OpenID Connect provider (Okta, Entra ID, Google, Auth0, Keycloak...).
# Register PUBLIC_URL/v1/auth/sso/callback as the redirect address there.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# What people know the provider as, used in messages ("your company" when empty).
OIDC_NAME=

# Terminal, Python and agent shell commands: off | local | docker
#   local runs bash on this machine in the board folder (not isolated)
#   docker runs each command in a throwaway container with no network
PARADIGM_SANDBOX=off
PARADIGM_DOCKER_IMAGE=node:22-bookworm

# Built-in agent (Pi) and the toolbar chat. Any one of these keys turns them on.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional: pick the model from the pi-ai catalog, e.g. anthropic / claude-sonnet-4-6
PI_PROVIDER=
PI_MODEL=

# Claude Agent SDK and Codex steps use ANTHROPIC_API_KEY and OPENAI_API_KEY
# (or CODEX_API_KEY) above. Their packages are large, so install them only if
# you use them: npm run agents:install
# Codex runs as `codex app-server`, which comes with the Codex SDK. To use
# another copy: CODEX_BIN=codex app-server
CODEX_BIN=

# ACP agents by name, as JSON. The ACP node's "Agent" setting picks one.
ACP_AGENTS={"gemini":"gemini --experimental-acp","opencode":"opencode acp"}

# Image generation: OpenRouter (through pi-ai) or OpenAI images. Optional model id.
IMAGE_MODEL=

# Video generation: any service with the OpenAI Videos API format
# (POST /videos, GET /videos/{id}, GET /videos/{id}/content), base URL ending in /v1.
VIDEO_API_URL=
VIDEO_API_KEY=
VIDEO_MODEL=sora-2

# Secrets the API request node may use as {{secret.NAME}}, as JSON.
HTTP_SECRETS={}
# Only for local development: let the API request node call localhost and private addresses.
PARADIGM_ALLOW_PRIVATE_HTTP=0

# How fast stand-in agent runs play back, in ms per step.
PARADIGM_SIM_STEP_MS=420
